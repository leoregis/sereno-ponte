<?xml version="1.0" encoding="utf-8"?>
<!-- O token do aparelho nunca vai para o backup do Google nem para outro celular. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
    </device-transfer>
</data-extraction-rules>
